{
  // Cloudflare Workers project "vault-it": the Worker's name here must match the project name in the Cloudflare dashboard.
  // Build command: npm run build:site        Deploy command: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-it",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Custom domains (the vault-it.co zone is Active on Cloudflare; Cloudflare creates them on deploy)
  "routes": [
    { "pattern": "app.vault-it.co", "custom_domain": true },
    { "pattern": "vault-it.co", "custom_domain": true },
    { "pattern": "www.vault-it.co", "custom_domain": true }
  ]
}
