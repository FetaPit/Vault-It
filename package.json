{
  "name": "vault-it",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "description": "Vault-It is a single-file app: index.html is joined from src/app by tools/build_app.js and committed. This file only declares the tooling the tests and builds use.",
  "scripts": {
    "test": "bash scripts/run-tests.sh all",
    "test:server": "bash scripts/run-tests.sh server",
    "test:browser": "bash scripts/run-tests.sh browser",
    "build:app": "node tools/build_app.js",
    "check:app": "node tools/build_app.js --check",
    "build:hb3d": "node tools/build_hb3d.js",
    "build:site": "node tools/build_site.js",
    "dev:site": "npm run build:site && wrangler dev",
    "deploy:dry": "npm run build:site && wrangler deploy --dry-run",
    "dev:phone": "node tools/dev_phone.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": ">=22"
  }
}
